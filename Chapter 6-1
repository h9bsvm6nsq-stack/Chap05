#include <stdio.h>

int main(void)
{
    int id = 1; /* set id as needed */
    double price = 0.0;

    if (id == 1)
    {
        price = 50.55;
    } 
    else if (id == 2 || id == 9) 
    {
        price = 12.35;
    } 
    else if (id == 5 || id == 7 || id == 11) 
    {
        price = 11.46;
    } 
    else 
    {
        price = -1;
    }

    printf("id=%d price=%.2f\n", id, price);
    return 0;
}
